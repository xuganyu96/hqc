CC:=gcc

CFLAGS:=-O3 -std=c99 -funroll-all-loops -flto -pedantic -Wall -Wextra

SHA3_SRC:=lib/fips202/fips202.c
SHA3_INCLUDE:=-I lib/fips202
RNG_SRC:=lib/nist-rng/rng.c
RNG_INCLUDE:=-I lib/nist-rng
RNG_CFLAGS:=-Wno-sign-compare -Wno-error=sign-compare
KAT_CFLAGS:=-Wno-unused-result -Wno-error=unused-result

SRC:=src/
INCLUDE:=-I src
LIB:=$(SHA3_INCLUDE) $(RNG_INCLUDE)

MAIN_HQC:=src/main_hqc.c
MAIN_KAT:=src/main_kat.c

HQC_OBJS:=vector.o reed_muller.o reed_solomon.o fft.o gf.o gf2x.o code.o parsing.o hqc.o hqc-kem.o symmetric.o crypto_memset.o rng.o
HQC_OBJS_VERBOSE:=vector.o reed_muller.o reed_solomon-verbose.o fft.o gf.o gf2x.o code-verbose.o parsing.o hqc-verbose.o hqc-kem-verbose.o symmetric.o crypto_memset.o rng.o
LIB_OBJS:= fips202.o

BIN:=bin
BUILD:=bin/build

folders:
	@/bin/echo -e "\n### Creating folders"
	mkdir -p $(BUILD)

fips202.o: | folders
	@/bin/echo -e "\n### Compiling fips202"
	$(CC) $(CFLAGS) -c $(SHA3_SRC) $(SHA3_INCLUDE) -o $(BUILD)/$@

rng.o: | folders
	@/bin/echo -e "\n### Compiling rng"
	$(CC) $(CFLAGS) $(RNG_CFLAGS) -c $(RNG_SRC) $(LIB) -o $(BUILD)/$@

%.o: $(SRC)/%.c | folders
	@/bin/echo -e "\n### Compiling $@"
	$(CC) $(CFLAGS) -c $< $(INCLUDE) $(LIB) -o $(BUILD)/$@

%-verbose.o: $(SRC)/%.c | folders
	@/bin/echo -e "\n### Compiling $@ (verbose mode)"
	$(CC) $(CFLAGS) -c $< $(INCLUDE) $(LIB) -D VERBOSE -o $(BUILD)/$@

hqc-xxx: $(HQC_OBJS) $(LIB_OBJS) | folders
	@/bin/echo -e "\n### Compiling hqc-xxx"
	$(CC) $(CFLAGS) $(MAIN_HQC) $(addprefix $(BUILD)/, $^) $(INCLUDE) $(LIB) -lcrypto -o $(BIN)/$@

hqc-xxx-kat: $(HQC_OBJS) $(LIB_OBJS) | folders
	@/bin/echo -e "\n### Compiling hqc-xxx KAT"
	$(CC) $(CFLAGS) $(KAT_CFLAGS) $(MAIN_KAT) $(addprefix $(BUILD)/, $^) $(INCLUDE) $(LIB) -lcrypto -o $(BIN)/$@

hqc-xxx-verbose: $(HQC_OBJS_VERBOSE) $(LIB_OBJS) | folders
	@/bin/echo -e "\n### Compiling hqc-xxx (verbose mode)"
	$(CC) $(CFLAGS) $(MAIN_HQC) $(addprefix $(BUILD)/, $^) $(INCLUDE) $(LIB) -D VERBOSE -lcrypto -o $(BIN)/$@


clean:
	rm -f PQCkemKAT_*
	rm -f vgcore.*
	rm -rf ./bin
